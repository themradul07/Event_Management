# BietHub Backend Configuration

PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local)
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/biethub?retryWrites=true&w=majority

# Nodemailer / Email Service Settings
EMPASS=your_email_app_password
GOOGLE_KEY=your_google_app_password

# Razorpay Test Mode Credentials
RAZORPAY_ID_KEY=rzp_test_your_key_id
RAZORPAY_SECRET_KEY=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Vapi AI Voice Recovery Agent Integration
VAPI_API_KEY=your_vapi_private_api_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_SERVER_URL=https://your-ngrok-url.ngrok-free.dev/vapi/webhook

# Ngrok Configuration for Live Webhooks
NGROK_AUTHTOKEN=your_ngrok_authtoken

# Cloudinary Storage Configuration
CLOUD_API_SECRET=your_cloudinary_secret

# LLM Integration Key
GEMINI_API_KEY=your_gemini_api_key
